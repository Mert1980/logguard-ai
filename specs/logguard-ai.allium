-- allium: 3
-- logguard-ai.allium

-- Scope: AI-driven error detection and analysis on OpenSearch logs
-- MVP:      local LLM, terminal output, no GitLab links
-- Post-MVP: Gemini API, Google Chat delivery, GitLab source links, team-based routing
--
-- Includes: Periodic error polling, three-state fingerprint deduplication with
--           occurrence escalation, LLM analysis, won't-fix suppression,
--           terminal output (MVP) / Google Chat notification (post-MVP)
-- Excludes:
--   - Log ingestion (owned by production Spring Boot services writing to OpenSearch)
--   - WARN and other non-ERROR log levels (post-MVP; will share deduplication_window)
--   - GitLab source links (post-MVP — requires service registry config)
--   - Admin UI or management API (all configuration via config files/environment variables)
--   - Authentication and user management
-- Persistence: embedded database (e.g. H2) for deduplication state and (post-MVP) failed notifications
-- Dependencies: None

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity OpenSearch {
    reachable: Boolean
}

-- MVP: local LLM (e.g. Ollama). Post-MVP: Gemini API.
-- [POST-MVP LANDMINE] When switching to Gemini, exclude ErrorLog.vdab_authorization
-- from the LLM payload — it contains VDAB LDAP identities that must stay on-prem.
external entity LLM {
    available: Boolean
    unavailability_reason: String?
}

-- Post-MVP only.
external entity GoogleChatWebhook {
    url: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Deduplication key derived from an ErrorLog.
-- Two errors with the same fingerprint and different KBO numbers are considered
-- the same error and suppressed within the deduplication window.

value ErrorFingerprint {
    exception_type: String
    throwing_method: String       -- class + method + LINE NUMBER of the first own-code frame
                                  -- [DESIGN INVARIANT] Line number is KEPT here intentionally.
                                  -- It distinguishes two different bugs in the same method.
                                  -- e.g. "LabelV2Config.getForwardingSource:21"
    stack_trace_sequence: String  -- structural sequence of the stack trace, tenant data stripped,
                                  -- LINE NUMBERS STRIPPED (normalized to Class.method(File.java:_))
                                  -- [DESIGN INVARIANT] Line numbers are STRIPPED here intentionally.
                                  -- This makes the fingerprint survive deploys that shift lines
                                  -- elsewhere in the call path without changing the throwing frame.
                                  -- WARNING: throwing_method and stack_trace_sequence have OPPOSITE
                                  -- line-number policies. Do NOT normalise both the same way —
                                  -- stripping line numbers from throwing_method would collapse
                                  -- distinct bugs into the same fingerprint.
}

-- Three-field output contract. Forces the LLM to name the class, method, and specific
-- failure rather than producing generic observations.
-- When the LLM is unavailable, the three analysis fields are absent; the error is
-- delivered as raw data with an "analysis unavailable" marker.

value LLMAnalysis {
    llm_available: Boolean
    root_cause: String?           -- one paragraph: what went wrong and why, referencing the specific
                                  -- be.vdab.* class and method involved
    likely_location: String?      -- ClassName.method:line (e.g. "LabelV2Config.getForwardingSource:21")
    suggested_action: String?     -- one paragraph: concrete steps the developer should take to
                                  -- investigate and fix the issue
    unavailability_reason: String?
}

-- Post-MVP only. A resolved link to a specific line in a GitLab source file.
-- Only generated for stack frames whose class name matches one of own_code_package_prefixes.

value GitLabLink {
    class_name: String
    line_number: Integer
    url: String
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- Post-MVP only. Maps an application name to its GitLab repository URL and source branch.

entity GitLabRepository {
    app_name: String
    repo_url: String
    source_branch: String    -- e.g. "main", "develop"; configurable per repository
}

-- Persistent cursor tracking the end of the last successful poll window.
-- last_successful_poll_at is null on first run, triggering the lookback prompt.
-- Never advanced when OpenSearch is unreachable, enabling automatic catch-up.
-- consecutive_poll_failures counts uninterrupted failures; resets to 0 on success.
-- degradation_started_at is set when the failure threshold is first reached and
-- cleared on recovery; drives the sticky degradation banner.

entity PollCheckpoint {
    last_successful_poll_at: Timestamp?   -- null = first run not yet completed
    consecutive_poll_failures: Integer
    degradation_started_at: Timestamp?    -- non-null while LogGuard is in degraded state
}

-- A single ERROR-level log entry retrieved from OpenSearch.
-- Fields map directly to _source.structured and _source.kubernetes.

entity ErrorLog {
    exception_type: String        -- structured.error.type
    error_message: String         -- structured.error.message
    stack_trace: String           -- structured.error.stack_trace
    service_name: String          -- structured.service.name
    app_name: String              -- kubernetes.labels.appName
    team: String                  -- kubernetes.namespace_labels.vdab_be_team (used for post-MVP routing)
    environment: String           -- kubernetes.namespace_labels.vdab_be_environment
    severity: String              -- structured.log.level (e.g. ERROR)
    occurred_at: Timestamp        -- @timestamp
    vdab_authorization: String?   -- vdab.authorization (LDAP DN of the triggering identity,
                                  -- e.g. "cn=MASTERBDB,ou=users,ou=intern,O=VDAB")
                                  -- Included in LLM payload for MVP (local LLM keeps data on-prem).
                                  -- [POST-MVP LANDMINE] This field MUST be excluded from the LLM
                                  -- payload before any cloud LLM integration (e.g. Gemini API).
                                  -- It contains VDAB LDAP identities that must not leave the
                                  -- on-prem environment. Failure to exclude it will silently ship
                                  -- internal user identities to a cloud provider.
}

-- Records that a fingerprint has been seen, enforcing the deduplication window.
-- Three-state gate:
--   new:       no active record → analyse and deliver
--   cooling:   active record, won't_fix=false → increment count, check escalation thresholds
--   won't-fix: active record, won't_fix=true → label once on re-encounter, then suppress
--
-- occurrence_count tracks total hits including suppressed duplicates.
-- stored_analysis is cached after the initial LLM call and reused for escalation
-- re-notifications — no fresh LLM call at threshold.
--
-- [DESIGN INVARIANT] LogGuard MUST NEVER write to the suppression file.
-- The suppression file is a developer-owned config artifact.
-- Format: one entry per line — "hash  # HumanLabel:line"
-- LogGuard reads it on every poll cycle but has no write authority over it.
-- Automated modification would silently override deliberate developer decisions.

entity DeduplicationRecord {
    fingerprint: ErrorFingerprint
    first_seen_at: Timestamp
    expires_at: Timestamp
    occurrence_count: Integer             -- total hits including suppressed duplicates
    last_notified_threshold: Integer?     -- highest escalation threshold that has fired (10, 100, 1000)
    won't_fix: Boolean                    -- true when fingerprint hash is in the suppression file
    stored_analysis: LLMAnalysis?         -- cached after initial LLM call; reused at escalation thresholds
}

-- Post-MVP only. A notification queued for Google Chat delivery with retry.
-- Persisted (persisted_at set) after max_delivery_attempts to survive restarts.

entity Notification {
    error_log: ErrorLog
    analysis: LLMAnalysis
    gitlab_links: List<GitLabLink>
    status: pending | delivered | failed
    attempt_count: Integer
    failure_reason: String?
    persisted_at: Timestamp?

    transitions status {
        pending -> delivered
        pending -> failed
        failed -> pending
        terminal: delivered
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    poll_interval: Duration = 5.minutes       -- MVP default; must be easily configurable
    deduplication_window: Duration = 24.hours
    escalation_thresholds: List<Integer> = [10, 100, 1000]
                                              -- occurrence counts that trigger re-notification
                                              -- 1000 also fires for won't-fix records (volume override)
    max_consecutive_poll_failures: Integer = 3
    own_code_package_prefixes: List<String>   -- e.g. ["be.vdab"] — used for stack trace truncation
                                              -- and GitLab link generation (post-MVP)
    suppression_file_path: String             -- path to the developer-owned won't-fix list
                                              -- format per entry: "hash  # HumanLabel:line"
    -- Post-MVP:
    max_delivery_attempts: Integer = 3
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- On first run (no checkpoint), prompt the developer for a lookback window
-- before the first poll begins.

rule InitialiseCheckpoint {
    when: checkpoint: PollCheckpoint.last_successful_poll_at = null
    ensures: FirstRunLookbackConfirmed()

    @guidance
        -- Print: "First run detected. Process last [N] hours of history? (default: 24h)"
        -- Wait for developer input. Accept a number of hours; 0 means start fresh from now.
        -- Set checkpoint.last_successful_poll_at = now - confirmed_lookback_hours.
        -- This rule fires once at startup and unblocks PollForErrors.
}

-- Reload the suppression file at the start of every poll cycle.
-- Runs before PollForErrors within the same cycle so the loaded list is current.

rule ReloadSuppressionFile {
    when: _: PollCheckpoint.last_successful_poll_at + config.poll_interval <= now
    ensures: SuppressionFileReloaded()

    @guidance
        -- Read config.suppression_file_path before each poll cycle.
        -- Parse lines of format: "hash  # HumanLabel:line" — hash is the lookup key;
        -- the comment is human-readable only and does not affect matching.
        -- If file is absent, treat as empty (no won't-fix entries — not an error).
        -- If file is unreadable or has a parse error:
        --   - Keep the previously loaded list in memory
        --   - Skip the reload
        --   - Print: "⚠️ Suppression file unreadable — using last known state"
        -- [DESIGN INVARIANT] LogGuard reads this file but NEVER writes to it.
}

-- Poll OpenSearch for new ERROR-level entries since the last checkpoint.
-- When OpenSearch is reachable, all new entries are handed off for processing
-- and the cursor is advanced after the full batch is emitted.

rule PollForErrors {
    when: checkpoint: PollCheckpoint.last_successful_poll_at + config.poll_interval <= now
    requires: OpenSearch.reachable
    let new_errors = ErrorLogs where occurred_at > checkpoint.last_successful_poll_at
    ensures:
        for error in new_errors:
            ErrorDetected(error)
    ensures: checkpoint.last_successful_poll_at = now
    ensures: checkpoint.consecutive_poll_failures = 0
    ensures: checkpoint.degradation_started_at = null

    @guidance
        -- [DESIGN INVARIANT] Advance last_successful_poll_at ONLY after ALL ErrorDetected
        -- events for the batch have been emitted — never before, never mid-batch.
        -- A crash after cursor advance but before event emission silently loses that batch.
        --
        -- If checkpoint.degradation_started_at was set, print the recovery line before polling:
        -- "🟢 LOGGUARD RECOVERED — polling resumed at [now], catching up from checkpoint"
        --
        -- Terminal output grouping for this poll cycle:
        --   - Buffer results by service_name
        --   - Print "Analyzing N new errors in [service-name]..." before LLM calls per service
        --   - Print each service block after all errors for that service are analysed
        --   - Order service blocks by error count descending
}

rule HandleOpenSearchUnreachable {
    when: checkpoint: PollCheckpoint.last_successful_poll_at + config.poll_interval <= now
    requires: not OpenSearch.reachable
    ensures:
        checkpoint.consecutive_poll_failures = checkpoint.consecutive_poll_failures + 1
        OpenSearchPollFailed(at: now)
        if checkpoint.consecutive_poll_failures >= config.max_consecutive_poll_failures
        and checkpoint.degradation_started_at = null:
            checkpoint.degradation_started_at = now
            OpenSearchDegradationDetected(consecutive_failures: checkpoint.consecutive_poll_failures)

    @guidance
        -- Do not advance last_successful_poll_at.
        -- The next scheduled poll queries from the same checkpoint, catching up automatically.
        -- If checkpoint.degradation_started_at is already set (already degraded), reprint the
        -- sticky banner on every cycle:
        -- "🔴 LOGGUARD DEGRADED — OpenSearch unreachable since [degradation_started_at] ([N] failures)"
        -- Reprinting each cycle prevents the banner scrolling off and creating false calm.
}

-- Three-state dedup gate — Path 1: new fingerprint → analyse and deliver.

rule ProcessNewError {
    when: ErrorDetected(error)
    let fingerprint = ErrorFingerprint(
        exception_type: error.exception_type,
        throwing_method: first_own_code_frame(error.stack_trace, config.own_code_package_prefixes),
        stack_trace_sequence: normalize_stack_trace(error.stack_trace, config.own_code_package_prefixes)
    )
    let active_record = DeduplicationRecords where fingerprint = fingerprint and expires_at > now
    requires: active_record = null
    let is_suppressed = fingerprint_hash(fingerprint) in loaded_suppression_file
    ensures: DeduplicationRecord.created(
        fingerprint: fingerprint,
        first_seen_at: now,
        expires_at: now + config.deduplication_window,
        occurrence_count: 1,
        last_notified_threshold: null,
        won't_fix: is_suppressed,
        stored_analysis: null
    )
    ensures: if not is_suppressed: ErrorReadyForAnalysis(error, fingerprint)
    ensures: if is_suppressed: WontFixEncountered(fingerprint)

    @guidance
        -- first_own_code_frame: class.method.LINE_NUMBER of the first frame whose class name
        -- starts with any prefix in own_code_package_prefixes.
        -- Fallback when no own-code frame exists (Spring startup, HikariCP, static 404s etc.):
        -- use the topmost frame of the stack trace so distinct framework errors do not
        -- collapse into a single fingerprint.
        --
        -- normalize_stack_trace: keep only own-code frames (plus topmost fallback if no own-code
        -- frame exists), strip line numbers from ALL frames in the sequence.
        -- See ErrorFingerprint [DESIGN INVARIANT] for the line-number asymmetry.
        --
        -- strip_tenant_data (applied within normalize_stack_trace to error_message and stack_trace):
        -- Strip: Belgian KBO numbers (0XXX.XXX.XXX), email addresses, LDAP DN fragments in free text.
        -- Keep: UUIDs/GUIDs (correlation IDs), numeric IDs, port numbers.
        -- vdab_authorization is a separate entity field — outside the strip scope by design.
        -- See [POST-MVP LANDMINE] on ErrorLog.vdab_authorization.
}

-- Three-state dedup gate — Path 2: cooling fingerprint → increment count, check escalation.

rule ProcessCoolingError {
    when: ErrorDetected(error)
    let fingerprint = ... -- same derivation as ProcessNewError
    let active_record = DeduplicationRecords where fingerprint = fingerprint and expires_at > now
    requires: active_record != null and active_record.won't_fix = false
    ensures: active_record.occurrence_count = active_record.occurrence_count + 1
    ensures: OccurrenceIncremented(active_record)
}

-- Three-state dedup gate — Path 3: won't-fix fingerprint within cooling window → silent.
-- Count is incremented to enable the 1,000× volume override (CheckEscalationThreshold).

rule ProcessWontFixError {
    when: ErrorDetected(error)
    let fingerprint = ... -- same derivation as ProcessNewError
    let active_record = DeduplicationRecords where fingerprint = fingerprint and expires_at > now
    requires: active_record != null and active_record.won't_fix = true
    ensures: active_record.occurrence_count = active_record.occurrence_count + 1
    ensures: OccurrenceIncremented(active_record)
    -- No analysis, no terminal output for normal occurrences.
    -- The 1,000× volume override fires via CheckEscalationThreshold when count reaches that threshold.
}

-- Won't-fix re-encounter: fingerprint resurfaces after the cooling window expired.
-- ProcessNewError routes here when the new record is immediately marked won't_fix.
-- Print the label once; the fresh cooling window suppresses further output.

rule HandleWontFixEncountered {
    when: WontFixEncountered(fingerprint)

    @guidance
        -- Print: "⚑ Known / Won't Fix: [HumanLabel]  [hash]"
        -- One label per cooling window. No LLM analysis.
        -- The HumanLabel and hash come from the suppression file entry for this fingerprint.
}

-- Fire an escalation re-notification when occurrence count crosses a threshold.
-- Thresholds fire for both cooling (won't_fix=false) and won't-fix (won't_fix=true) records,
-- but won't-fix records only fire at 1,000× (volume override — see DeliverEscalation).

rule CheckEscalationThreshold {
    when: OccurrenceIncremented(record)
    let next_threshold = min t in config.escalation_thresholds
                         where t > (record.last_notified_threshold ?? 0)
                           and record.occurrence_count >= t
    requires: next_threshold != null
    ensures: record.last_notified_threshold = next_threshold
    ensures: EscalationThresholdReached(record, next_threshold)
}

-- Deliver escalation re-notification to terminal.
-- Reuses stored_analysis — no fresh LLM call. Protects local LLM budget.

rule DeliverEscalation {
    when: EscalationThresholdReached(record, threshold)

    @guidance
        -- Standard cooling error re-notification:
        -- "⚠️ Known error [HumanLabel] now seen [threshold]× since [first_seen_at]"
        -- "   Root cause: [stored_analysis.root_cause]"  (or "no analysis on file" if absent)
        --
        -- Won't-fix volume override (fires at 1,000× even for won't_fix=true records):
        -- "⚠️ Won't-fix error [HumanLabel] now seen 1,000× since [first_seen_at]"
        -- "   [Your won't-fix decision stands — volume is unusually high]"
        -- Won't-fix state is NOT cleared after the override fires. The developer must edit
        -- the suppression file to change their decision. This is a read-only nudge.
        --
        -- For won't-fix records: only fire at the 1,000× threshold, not at 10× or 100×.
        -- (Threshold filtering: requires record.won't_fix = false OR threshold = 1000)
}

-- Send the error to the LLM for analysis.
-- MVP: local LLM. Post-MVP: Gemini API (exclude vdab_authorization from payload first).
-- On LLM failure: deliver raw error data with "analysis unavailable" — never drop silently.

rule AnalyseError {
    when: ErrorReadyForAnalysis(error, fingerprint)
    let analysis =
        if LLM.available:
            analyse_with_llm(error)
        else:
            LLMAnalysis(
                llm_available: false,
                unavailability_reason: LLM.unavailability_reason ?? "unknown"
            )
    let record = DeduplicationRecord where fingerprint = fingerprint
    ensures: record.stored_analysis = analysis
    ensures: ErrorAnalysed(error, analysis, fingerprint)

    @guidance
        -- LLM prompt instruction frame (confirmed):
        -- "You are a Java backend engineer. Given this Spring Boot error, identify the most
        --  likely root cause in the application code. Focus only on be.vdab.* frames.
        --  Be specific — name the class, method, and what likely went wrong there."
        --
        -- LLM payload (MVP — local LLM):
        --   exception_type, error_message, stack_trace (be.vdab.* frames only, truncated),
        --   service_name, app_name, vdab_authorization.
        -- [POST-MVP LANDMINE] Exclude vdab_authorization before switching to cloud LLM.
        --
        -- Expected output contract:
        --   Root cause:      [one paragraph — what went wrong and why, naming the specific
        --                     be.vdab.* class and method involved]
        --   Likely location: ClassName.method:line
        --   Suggested action:[one paragraph — concrete steps to investigate and fix the issue]
        --
        -- On LLM failure (timeout, crash, malformed response): set llm_available=false,
        -- proceed to DeliverToTerminal with raw error data. Never discard the error.
}

-- MVP: print analysis result to terminal.

rule DeliverToTerminal {
    when: ErrorAnalysed(error, analysis, fingerprint)

    @guidance
        -- Output block format (one block per error, within service group):
        --
        -- ── orgbeheer-service (4 errors) ──────────────────
        -- [1/4] NPE@OrderService
        --   Root cause:      [analysis.root_cause | "analysis unavailable"]
        --   Likely location: [analysis.likely_location]
        --   Suggested action:[analysis.suggested_action]
        --   Fingerprint: NPE@LabelV2Config:21  [a3f9c2b1]
        --
        -- The Fingerprint line enables copy-paste suppression: developer copies the hash
        -- and adds it to config.suppression_file_path to create a won't-fix entry.
        -- Suppression file format: "a3f9c2b1  # NPE@LabelV2Config:21"
        --
        -- Service blocks are printed after all errors for that service are analysed.
        -- Service blocks are ordered by error count descending within each poll cycle.
}

------------------------------------------------------------
-- Post-MVP: Google Chat delivery
------------------------------------------------------------

-- Attempt delivery of a pending notification to Google Chat.
-- The implementation emits DeliverySucceeded or DeliveryFailed depending on the outcome.

rule DeliverNotification {
    when: notification: Notification.status becomes pending
    ensures: DeliveryAttempted(notification)

    @guidance
        -- POST the notification to the Google Chat webhook. On HTTP 200, emit
        -- DeliverySucceeded(notification). On any error, emit DeliveryFailed(notification, reason).
        -- Use exponential backoff between attempts (e.g. 10s, 20s, 40s) at the call site.
}

rule NotificationDeliverySucceeded {
    when: DeliverySucceeded(notification)
    requires: notification.status = pending
    ensures: notification.status = delivered
}

rule NotificationDeliveryFailed {
    when: DeliveryFailed(notification, reason)
    requires: notification.status = pending
    ensures:
        notification.failure_reason = reason
        notification.attempt_count = notification.attempt_count + 1
        if notification.attempt_count >= config.max_delivery_attempts:
            notification.status = failed
            notification.persisted_at = now
}

-- At the start of each poll cycle, reset any persisted failed notifications
-- back to pending so they are retried.

rule RetryPersistedNotifications {
    when: _: PollCheckpoint.last_successful_poll_at + config.poll_interval <= now
    for notification in Notifications where status = failed and persisted_at != null:
        ensures: notification.status = pending
        ensures: notification.attempt_count = 0
}
